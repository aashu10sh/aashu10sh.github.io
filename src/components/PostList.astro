---
import { formatDate, postUrl, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				<a href={postUrl(post)}>{post.data.title}</a>
			</li>
		))
	}
</ul>
