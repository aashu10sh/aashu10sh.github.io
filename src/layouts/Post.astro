---
import { render } from 'astro:content';
import Base from './Base.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const book = post.collection === 'books';
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<Base title={post.data.title} description={post.data.description}>
	<article>
		<header class="post-header">
			<h1>{post.data.title}</h1>
			<p class="muted mono">
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{' · '}{minutes} min read
			</p>
			<div class="tags">
				{post.data.tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
	<hr />
	<p><a href={book ? '/books' : '/blogs'} class="muted">← All {book ? 'books' : 'posts'}</a></p>
</Base>

<script>
	import Lightense from 'lightense-images';

	Lightense('.prose img', { background: 'rgba(43, 43, 43, 0.19)' });
</script>

<style>
	.prose {
		overflow-wrap: break-word;
	}
	.prose :global(img) {
		cursor: zoom-in;
	}
	.post-header {
		margin-bottom: 2.5rem;
	}
	.post-header p {
		margin: 0 0 0.5rem;
	}
	.prose :global(p),
	.prose :global(li) {
		hyphens: auto;
	}
	.prose :global(h1) {
		font-size: 1.3rem;
		margin: 2.5rem 0 0.75rem;
	}
</style>
